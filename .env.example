POSTGRES_DB=secure_knowledge
POSTGRES_USER=secure_knowledge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://secure_knowledge:change-me@postgres:5432/secure_knowledge
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=secure-knowledge-core
JWT_AUDIENCE=secure-knowledge-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

OBJECT_STORAGE_BUCKET=secure-knowledge-documents
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-2.5-flash
ANSWER_MINIMUM_RETRIEVAL_SCORE=0.015
ANSWER_MINIMUM_VECTOR_SIMILARITY=0.55
ANSWER_MINIMUM_PASSAGE_CHARACTERS=40
ANSWER_RETRIEVAL_LIMIT=10

MAX_UPLOAD_SIZE_BYTES=20971520
INGESTION_LEASE_SECONDS=900
